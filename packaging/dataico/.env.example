# Copy to packaging/dataico/.env (git-ignored) and fill in. Variables already set
# in your shell take precedence over this file. Leave APPLE_SIGNING_IDENTITY
# unset/commented for an unsigned (ad-hoc) local build.

# Server the app talks to (host only, no https://).
# VITE_API_BASE_URL=hopp.apps.dataico.world

# Optional: prebuilt libwebrtc directory (otherwise webrtc-sys downloads it).
# LK_CUSTOM_WEBRTC=/path/to/webrtc/mac-arm64-release

# Code signing: exact name from `security find-identity -v -p codesigning`.
# APPLE_SIGNING_IDENTITY="Developer ID Application: Dataico Example (ABCDE12345)"

# Notarization, preferred: App Store Connect API key (Team key, "Developer" role or higher).
# APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
# APPLE_API_KEY=ABCDE12345
# APPLE_API_KEY_PATH=/Users/you/.appstoreconnect/private_keys/AuthKey_ABCDE12345.p8

# Notarization, alternative: Apple ID + app-specific password (appleid.apple.com).
# APPLE_ID=you@example.com
# APPLE_PASSWORD=abcd-efgh-ijkl-mnop
# APPLE_TEAM_ID=ABCDE12345
